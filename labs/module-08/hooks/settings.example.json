{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "dotnet \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bin/AgentHooks.dll\" guard --rules gates/architecture.rules", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "dotnet \"${CLAUDE_PROJECT_DIR}/.claude/mcp/contoso-schema/ContosoSchema.Mcp.dll\" check-sql --hook --source sql --migrations \"${CLAUDE_PROJECT_DIR}/db/migrations\"", "timeout": 30 }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "dotnet \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bin/AgentHooks.dll\" audit", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "dotnet \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bin/AgentHooks.dll\" audit", "timeout": 5 }
        ]
      }
    ]
  }
}
