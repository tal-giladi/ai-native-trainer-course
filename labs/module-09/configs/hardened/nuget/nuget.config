<?xml version="1.0" encoding="utf-8"?>
<!-- Package-source mapping (lesson 09.3): every package ID, including transitive ones, must match a
     pattern for an approved source. A hallucinated or typosquat name (A05: Contoso.Billing.Helpers)
     matches no pattern here, so restore fails fast instead of silently pulling from a public feed.
     See https://learn.microsoft.com/nuget/consume-packages/package-source-mapping -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- The exact IDs Contoso Billing already uses. Nothing else restores without a review. -->
      <package pattern="Dapper" />
      <package pattern="Microsoft.Data.SqlClient" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="xunit" />
      <package pattern="xunit.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
