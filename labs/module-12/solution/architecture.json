  },
  "routes": [
    {
      "id": "primary",
      "role": "primary",
      "provider": "hyperscaler-a",
      "endpoint": "eu geographic inference profile",
      "geo": "eu"
    },
    {
      "id": "fallback",
      "role": "fallback",
      "provider": "hyperscaler-b",
      "endpoint": "eu multi-region endpoint",
      "geo": "eu"
    }
  ],
